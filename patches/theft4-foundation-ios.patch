+bool Gta4NativeGraphicsSystem::RecordPackedDepthSurfaceResolve(
+    VkCommandBuffer command_buffer, NativeSurfaceImage& source,
+    NativeTextureImage& destination, const VkRect2D& rectangle, bool float24) {
+  constexpr VkImageAspectFlags aspects = VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT;
+  // The existing Theft4 packing shader indexes absolute pixel coordinates.
+  // Caller guarantees identical source/destination origins and no scaling.
+  if (source.aspect != aspects || !source.aspect_content.Has(aspects) ||
+      source.samples != VK_SAMPLE_COUNT_1_BIT || !source.sampled_view ||
+      destination.format != VK_FORMAT_R8G8B8A8_UNORM ||
+      destination.aspect != VK_IMAGE_ASPECT_COLOR_BIT || !frame_descriptor_pool_) return false;
+  auto* provider = static_cast<ui::vulkan::VulkanProvider*>(provider_.get());
+  const auto* device = provider->vulkan_device();
+  const auto& dfn = device->functions();
+  if (!source.sampled_stencil_view) {
+    VkImageViewCreateInfo view{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    view.image = source.resource.image;
+    view.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    view.format = source.format;
+    view.subresourceRange = ui::vulkan::util::InitializeSubresourceRange(
+        VK_IMAGE_ASPECT_STENCIL_BIT, 0, 1, 0, 1);
