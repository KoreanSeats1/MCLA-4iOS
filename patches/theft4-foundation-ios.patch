+  }
+  if (parse_end == storage.c_str() || errno == ERANGE) {
+    return false;
+  }
+  if (consumed) {
+    *consumed = static_cast<size_t>(parse_end - storage.c_str());
+  }
+  return true;
+#else
+  auto parsed = std::from_chars(range.data(), range.data() + range.size(),
+                                result, std::chars_format::general);
+  if (parsed.ec != std::errc()) {
+    return false;
+  }
+  if (consumed) {
+    *consumed = static_cast<size_t>(parsed.ptr - range.data());
+  }
+  return true;
+#endif
