diff --git a/src/mc_engine/frame_delta_guard.h b/src/mc_engine/frame_delta_guard.h
new file mode 100644
index 0000000..497c984
--- /dev/null
+++ b/src/mc_engine/frame_delta_guard.h
@@ -0,0 +1,12 @@
+#pragma once
+#include <cstdint>
+
+namespace mc {
+// Same unconditional 125 ms hitch limit used by the desktop MCLA hook.
+// Only bound elapsed ticks; preserve the title's original fixed-step path.
+constexpr uint64_t ClampFrameDeltaTicks(uint64_t ticks,uint64_t frequency) {
+    const uint64_t hz=frequency ? frequency : 50000000;
+    const uint64_t cap=hz/8;
+    return ticks>cap ? cap : ticks;
+}
+}
diff --git a/src/mc_engine/frame_rate_scaling.h b/src/mc_engine/frame_rate_scaling.h
new file mode 100644
index 0000000..143d650
--- /dev/null
+++ b/src/mc_engine/frame_rate_scaling.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <cmath>
+namespace mc {
+// Preserve the console's one-second decay, including the game's <60 FPS
+// half-factor branch. Round as the guest does without an unsafe float cast.
+inline double CameraSmoothing(double raw, double dt, double fps) {
+    if (!std::isfinite(raw) || !std::isfinite(dt) || !std::isfinite(fps) ||
+        raw <= 0 || raw >= 1 || dt <= 0 || fps <= 0) return raw;
+    const double k30 = std::round(fps) < 60 ? raw : raw * 0.5;
+    return 1.0 - std::pow(1.0 - k30, dt * 30.0);
+}
+inline double ChassisSmoothing(double original, double dt) {
+    if (!std::isfinite(dt) || dt <= 0) return original;
+    return 1.0 - std::pow(0.90, dt * 30.0);
+}
+}
