+static bool MCLADeviceAspect(PPCRegister& value, unsigned hookBit) {
+    // On iPad, this hook alone corrected the gameplay camera while retaining
+    // the centered, undistorted 2D title/HUD projection. The remaining three
+    // collectively disturbed authored UI placement and are left off. Keep a
+    // process-local mask for controlled A/B captures on other devices.
+    static const unsigned hookMask = [] {
+        const char* text = std::getenv("MCLA_ASPECT_HOOK_MASK");
+        return text ? unsigned(std::strtoul(text, nullptr, 0)) : 4u;
+    }();
+    if ((hookMask & hookBit) == 0) return false;
+    uint32_t width = 1280, height = 720;
+    MCLAGraphicsGuestVideoSize(&width, &height);
+    if (width == 1280 && height == 720) return false;
+    value.f64 = double(width) / double(height);
+    return true;
+}
 
